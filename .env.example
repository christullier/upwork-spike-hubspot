# Copy to .env and fill in. Never commit the real .env.

# --- Webhook security ---
# Shared secret used to sign webhook requests (HMAC-SHA256). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=change-me
# Reject requests whose X-Timestamp is further than this from server time.
SIGNATURE_TOLERANCE_SECONDS=300

# --- Claude (classification) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_SECONDS=15
ANTHROPIC_MAX_RETRIES=2

# --- HubSpot (private app token) ---
HUBSPOT_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_MAX_RETRIES=3

# Deal pipeline and stage IDs. Run `python scripts/list_pipelines.py` to print yours.
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_QUOTE=
HUBSPOT_STAGE_COI=
HUBSPOT_STAGE_POLICY_CHANGE=
HUBSPOT_STAGE_RENEWAL=
HUBSPOT_STAGE_REVIEW=

# Optional: HubSpot owner ID to assign per request type (leave blank for unassigned).
HUBSPOT_OWNER_QUOTE=
HUBSPOT_OWNER_COI=
HUBSPOT_OWNER_POLICY_CHANGE=
HUBSPOT_OWNER_RENEWAL=
HUBSPOT_OWNER_REVIEW=

# Custom deal property that stores the idempotency key (single-line text).
# Leave blank to skip the HubSpot-side duplicate check and rely on the local ledger only.
HUBSPOT_IDEMPOTENCY_PROPERTY=intake_idempotency_key

# --- Idempotency ledger ---
IDEMPOTENCY_DB_PATH=intake_ledger.db
IDEMPOTENCY_WINDOW_SECONDS=3600

LOG_LEVEL=INFO
